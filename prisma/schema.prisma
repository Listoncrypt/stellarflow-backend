generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model PriceHistory {
  id          Int       @id @default(autoincrement())
  currency    String
  rate        Decimal
  bid         Decimal? // Buy price (optional)
  ask         Decimal? // Sell price (optional)
  source      String
  timestamp   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  currencyRef Currency? @relation(fields: [currency], references: [code])

  @@index([currency, timestamp])
  @@index([timestamp])
  @@unique([currency, source, timestamp])
}

model Currency {
  code        String    @id  // e.g., "GHS", "KES"
  name        String      // Full name e.g., "Ghanaian Cedi"
  symbol      String      // Currency symbol e.g., "₵", "KES"
  decimals    Int       @default(2)           // Decimal places for display
  isActive    Boolean   @default(true)        // Whether this currency is currently supported
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  priceHistory PriceHistory[]
}

// On-Chain Confirmed Price Model
// Stores prices confirmed on Stellar via manageData or Soroban contract events
model OnChainPrice {
  id            Int       @id @default(autoincrement())
  currency      String    // e.g., "NGN", "KES", "GHS"
  rate          Decimal   // The confirmed price
  txHash        String    // Stellar transaction hash
  memoId        String?   // Memo ID from transaction (e.g., SF-NGN-1234567890-001)
  ledgerSeq     Int                          // Ledger sequence number
  confirmedAt   DateTime   // When transaction was confirmed on-chain

  @@index([currency, confirmedAt])
  @@index([txHash])
  @@index([ledgerSeq])
  @@unique([txHash, currency])

  createdAt     DateTime  @default(now())
}

model ProviderReputation {
  id              Int       @id @default(autoincrement())
  providerName    String  // e.g., "CoinGecko", "ExchangeRateAPI"
  endpoint        String?  // Specific endpoint URL or identifier
  status          String   // "online", "offline", "degraded"
  totalRequests   Int       @default(0)       // Total API calls made
  successfulRequests Int    @default(0)       // Successful responses
  failedRequests  Int       @default(0)       // Failed responses
  incorrectResponses Int   @default(0)        // Responses with invalid/incorrect data
  averageLatency  Float?    // Average response time in ms
  lastSuccess     DateTime?                    // Last successful response timestamp
  lastFailure     DateTime?                    // Last failed response timestamp
  lastIncorrect   DateTime?                    // Last incorrect response timestamp
  consecutiveFailures Int  @default(0)        // Current streak of consecutive failures
  consecutiveIncorrect Int @default(0)        // Current streak of consecutive incorrect responses
  
  // Reliability metrics
  reliabilityScore Float?   // Calculated score (0-100)
  lastUpdated     DateTime  @updatedAt
  
  createdAt       DateTime  @default(now())
  
  // Indexes for quick lookups
  @@index([providerName])
  @@index([status])
  @@index([reliabilityScore])
  @@unique([providerName, endpoint])
}

// Multi-Sig Price Approval Model
// Tracks price updates that require signatures from multiple oracle servers
model MultiSigPrice {
  id                Int       @id @default(autoincrement())
  priceReviewId     Int       // Reference to the price_review_records with contract_status tracking
  currency          String   // e.g., "NGN", "KES", "GHS"
  rate              Decimal   // The price to be updated
  source            String   // Price source (e.g., "CoinGecko")
  
  // Multi-sig status
  status            String   // "PENDING", "APPROVED", "REJECTED", "EXPIRED"
  requiredSignatures Int      @default(2)       // Number of signatures needed (typically 2)
  collectedSignatures Int     @default(0)       // Number of signatures collected so far
  
  // Stellar transaction details (set when fully signed)
  memoId            String?   // Memo ID from transaction
  stellarTxHash     String?   // Submitted transaction hash
  submittedAt       DateTime?                    // When transaction was submitted to Stellar
  
  // Timestamps
  requestedAt       DateTime  @default(now())   // When the multi-sig request was created
  expiresAt         DateTime                     // Expiration time for the signature request
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([currency, status, requestedAt])
  @@index([status, expiresAt])
  @@index([priceReviewId])

  multiSigSignatures MultiSigSignature[]
}

// Multi-Sig Signature Model
// Records individual signatures from oracle servers
model MultiSigSignature {
  id                Int       @id @default(autoincrement())
  multiSigPriceId   Int       // Reference to MultiSigPrice
  multiSigPrice     MultiSigPrice @relation(fields: [multiSigPriceId], references: [id], onDelete: Cascade)
  
  // Server/Signer information
  signerPublicKey   String    // Stellar public key of the signer
  signerName        String    // Human-readable name (e.g., "oracle-server-1")
  
  // Signature details
  signature         String    // The actual XDR signature (can be long)
  signedAt          DateTime  @default(now())   // When the signature was created
  
  createdAt         DateTime  @default(now())
  
  @@unique([multiSigPriceId, signerPublicKey])  // Prevent duplicate signatures from same signer
  @@index([multiSigPriceId])
  @@index([signerPublicKey])
}

// Error log table for tracking provider/fetcher failures
model ErrorLog {
  id           String   @id  // K-sortable KSUID (26-char Crockford Base32)
  providerName String   // e.g., "CoinGecko", "KESRateFetcher"
  errorMessage String?
  occurredAt   DateTime
  createdAt    DateTime  @default(now())

  @@index([providerName])
  @@index([occurredAt])
}

model RawData {
  id        Int      @id @default(autoincrement())
  currency  String
  provider  String
  endpoint  String?
  payload   String
  fetchedAt DateTime
  createdAt DateTime @default(now())

  @@index([currency, fetchedAt])
  @@index([provider, fetchedAt])
  @@index([createdAt])
}

model Relayer {
  id            Int      @id @default(autoincrement())
  name          String
  apiKey        String   @unique
  isActive      Boolean  @default(true)
  allowedAssets String
  whitelistedIps  String[]
  email           String?  @unique
  passwordHash    String?
  role            String?  @default("VIEWER")
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  permissionChanges PermissionChange[]
  sessions          UserSession[]
  registry          RelayerRegistry?
}

model RelayerRegistry {
  id               Int      @id @default(autoincrement())
  relayerId        Int      @unique
  relayer          Relayer  @relation(fields: [relayerId], references: [id], onDelete: Cascade)
  contactName      String
  email            String
  organizationName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  label      String?
  scopes     String[]
  ownerId    String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model UserSession {
  id           Int       @id @default(autoincrement())
  relayerId   Int
  relayer     Relayer   @relation(fields: [relayerId], references: [id])
  token       String    @unique
  ipAddress   String
  userAgent   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  isActive    Boolean   @default(true)
}

model PermissionChange {
  id          Int       @id @default(autoincrement())
  relayerId  Int
  relayer    Relayer   @relation(fields: [relayerId], references: [id])
  changedBy  Int
  targetId   Int?
  field      String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime  @default(now())
}

// OHLC Candle Model – Issue #208: Analytics | Time-Series Data Aggregation Service
// Stores Open/High/Low/Close aggregates produced by the PriceAggregator worker.
// Granularity is one of "MINUTE" | "HOUR" | "DAY".
model OhlcCandle {
  id          Int      @id @default(autoincrement())
  currency    String   // e.g., "NGN", "KES", "GHS"
  granularity String   // "MINUTE" | "HOUR" | "DAY"
  openTime    DateTime // Start of the candle window (UTC, truncated to granularity)
  closeTime   DateTime // End of the candle window (exclusive)

  open        Decimal  // First price in the window
  high        Decimal  // Highest price in the window
  low         Decimal  // Lowest price in the window
  close       Decimal  // Last price in the window
  count       Int      @default(0) // Number of raw ticks aggregated

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Composite unique – one candle per (currency, granularity, openTime)
  @@unique([currency, granularity, openTime])

  // Primary query pattern: fetch candles for a currency/granularity over a time range
  @@index([currency, granularity, openTime])
  // Secondary: sweep all candles in a time range (e.g. backfill checks)
  @@index([granularity, openTime])
}

// Hourly Statistics for smoothing out price spikes
model HourlyStats {
  id           Int      @id @default(autoincrement())
  currency     String
  averageRate  Decimal
  hour         DateTime // The start of the hour this average represents
  createdAt    DateTime  @default(now())

  @@unique([currency, hour])
  @@index([hour])
}
model OhlcvCandle {
  id        String   @id @default(uuid())
  pair      String   @db.VarChar(10)
  timeframe String   // e.g., "1m", "15m", "1h", "1d"
  open      Decimal  @db.Decimal(20, 10)
  high      Decimal  @db.Decimal(20, 10)
  low       Decimal  @db.Decimal(20, 10)
  close     Decimal  @db.Decimal(20, 10)
  volume    Decimal  @db.Decimal(20, 10)
  timestamp DateTime @db.Timestamp(3)
  @@unique([pair, timeframe, timestamp])
  @@index([pair, timeframe, timestamp])
}

model PoolLiquidity {
  id        String   @id @default(uuid())
  poolId    String   @db.VarChar(50)
  timestamp DateTime @db.Timestamp(3)
  liquidity Decimal  @db.Decimal(20, 10)
  @@unique([poolId, timestamp])
  @@index([poolId, timestamp])
}

model GovernanceProposal {
  id                   Int              @id @default(autoincrement())
  proposalId           String           @unique
  contractId           String
  title                String?
  actionType           String?
  actionData           String?
  expiresAt            DateTime
  status               String           @default("Queued")
  transactionHash      String?
  executedAt           DateTime?
  cancelledAt          DateTime?
  queuedAt             DateTime?
  timelockActionSource String?
  notificationCount    Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  votes                GovernanceVote[]

  @@index([status, expiresAt])
  @@index([contractId])
  @@index([actionType])
}

enum RebalancingSwapStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model RebalancingSwap {
  id                String                @id @default(uuid())
  poolKey           String                @db.VarChar(100)
  anchorAccount     String                @db.VarChar(56)
  fromCurrency      String                @db.VarChar(12)
  toCurrency        String                @db.VarChar(12)
  fromAmount        Decimal               @db.Decimal(30, 7)
  estimatedToAmount Decimal               @db.Decimal(30, 7)
  normalizedVolume  Decimal               @db.Decimal(30, 7)
  fromReserveRatio  Decimal               @db.Decimal(8, 7)
  toReserveRatio    Decimal               @db.Decimal(8, 7)
  status            RebalancingSwapStatus @default(QUEUED)
  managerAccounts   String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([poolKey, status])
  @@index([status, createdAt])
}

model OpenOrder {
  id           String   @id @default(uuid())
  orderId      String   @unique
  totalAmount  Decimal  @db.Decimal(38, 18)
  filledAmount Decimal  @default(0) @db.Decimal(38, 18)
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model OrderFilledEvent {
  id         String   @id @default(uuid())
  orderId    String
  fillAmount Decimal  @db.Decimal(38, 18)
  txHash     String
  ledgerSeq  Int
  eventIndex Int
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([orderId, ledgerSeq])
}

model PaymentRoute {
  id               String    @id @default(uuid())
  senderCurrency   String
  receiverCurrency String
  sourceAsset      String
  targetRail       String
  provider         String
  rate             Decimal
  fee              Decimal
  estimatedAmount  Decimal
  slippageBps      Int       @default(0)
  liquidityPoolId  String?
  priority         Int       @default(0)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fxQuotes         FxQuote[]

  @@index([sourceAsset, targetRail])
  @@index([senderCurrency, receiverCurrency])
}

model IssuerOnboardingRequest {
  id               Int       @id @default(autoincrement())
  name             String
  licenseNumber    String
  country          String
  walletAddress    String
  status           String    @default("PENDING")
  reviewedBy       String?
  reviewNote       String?
  reviewedAt       DateTime?
  addedToAllowlist Boolean   @default(false)
  allowlistTxHash  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([walletAddress])
}

model AuditLog {
  id             String   @id
  eventType      String
  actionType     String?
  relatedId      Int?
  actorPublicKey String
  actorName      String
  actorRole      String?
  eventDetails   String?
  previousState  String?
  newState       String?
  ipAddress      String?
  userAgent      String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([actorPublicKey])
  @@index([occurredAt])
}

model PendingConsensus {
  id                  Int                @id @default(autoincrement())
  actionType          String
  actionData          String?
  status              String             @default("PENDING")
  requiredSignatures  Int
  collectedSignatures Int                @default(0)
  requestedBy         String
  requestedAt         DateTime           @default(now())
  expiresAt           DateTime
  executedAt          DateTime?
  executionResult     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pendingSignatures   PendingSignature[]

  @@index([status])
}

model PendingSignature {
  id                 Int              @id @default(autoincrement())
  pendingConsensusId Int
  pendingConsensus   PendingConsensus @relation(fields: [pendingConsensusId], references: [id], onDelete: Cascade)
  adminPublicKey     String
  adminName          String?
  signature          String
  signedAt           DateTime         @default(now())
  createdAt          DateTime         @default(now())

  @@unique([pendingConsensusId, adminPublicKey])
  @@index([pendingConsensusId])
  @@index([adminPublicKey])
}

model FxQuote {
  id               String        @id @default(uuid())
  paymentRouteId   String
  paymentRoute     PaymentRoute  @relation(fields: [paymentRouteId], references: [id])
  senderCurrency   String
  receiverCurrency String
  inputAmount      Decimal       @db.Decimal(30, 7)
  outputAmount     Decimal       @db.Decimal(30, 7)
  rate             Decimal       @db.Decimal(30, 7)
  fee              Decimal       @db.Decimal(30, 7)
  slippageBps      Int           @default(0)
  liveFeedRate     Decimal?      @db.Decimal(30, 7)
  feedSource       String?
  feedTimestamp    DateTime?
  rateDeviationBps Int           @default(0)
  expiresAt        DateTime
  lockedAt         DateTime?
  executedAt       DateTime?
  status           String        @default("PENDING")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([senderCurrency, receiverCurrency])
  @@index([status, expiresAt])
  @@index([paymentRouteId])
}

model TimelockEvent {
  id         String   @id @default(uuid())
  eventType  String
  proposalId String
  contractId String
  ledgerSeq  Int      @default(0)
  txHash     String?
  topics     String?
  value      String?
  expiresAt  DateTime?
  status     String   @default("QUEUED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([txHash, eventType, proposalId], name: "txHash_eventType_proposalId")
  @@index([proposalId])
  @@index([status])
}

model ComplianceMetadata {
  id               String    @id @default(uuid())
  route            String?   @unique
  riskScore        Float?
  isChecked        Boolean   @default(true)
  relayerId        Int?
  relayerName      String?
  eventType        String?
  payloadTimestamp DateTime?
  receivedAt       DateTime?
  latencyDiffMs    Int?
  thresholdMs      Int?
  details          String?
  resolved         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([relayerName])
  @@index([eventType])
}

model GovernanceVote {
  id         Int                @id @default(autoincrement())
  accountId  String
  proposalId String
  proposal   GovernanceProposal @relation(fields: [proposalId], references: [proposalId])
  choice     String
  weight     Decimal            @db.Decimal(30, 7)
  txHash     String?
  votedAt    DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([accountId, proposalId])
  @@index([accountId])
  @@index([proposalId])
}


